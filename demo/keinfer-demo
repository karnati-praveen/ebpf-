#!/usr/bin/env bash
set -euo pipefail
APP_ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
export SHARDWISE_HOME="${SHARDWISE_HOME:-${KEINFER_DEMO_HOME:-$HOME/.local/share/shardwise}}"
export KEINFER_DEMO_HOME="$SHARDWISE_HOME"
RUNTIME_PY="$KEINFER_DEMO_HOME/runtime/bin/python"
case "${1:-solo}" in
  stop|status)
    if [[ ! -f "$KEINFER_DEMO_HOME/state/app.json" ]]; then
      echo 'Shardwise is not running'
      exit 0
    fi
    if [[ ! -x "$RUNTIME_PY" ]]; then
      echo 'Shardwise runtime is unavailable; restore setup before controlling the recorded instance. No processes were signalled.' >&2
      exit 1
    fi
    exec "$RUNTIME_PY" "$APP_ROOT/demo/app.py" "$@"
    ;;
esac
mkdir -p "$KEINFER_DEMO_HOME/state"
# Serialize setup as well as execution, before altering the runtime environment.
exec 9>"$KEINFER_DEMO_HOME/state/launcher.lock"
if ! flock -n 9; then
  echo 'Demo already running or setting up; use shardwise status or stop' >&2
  exit 1
fi
# A directly launched app does not own launcher.lock; inspect its runtime lock too.
exec 8>"$KEINFER_DEMO_HOME/state/lock"
if ! flock -n 8; then
  echo 'Demo already running; use shardwise status or stop' >&2
  exit 1
fi
flock -u 8
exec 8>&-
export SHARDWISE_BIN="${SHARDWISE_BIN:-${KEINFER_BIN:-/opt/shardwise/bin}}"
export KEINFER_BIN="$SHARDWISE_BIN"
DEVICE_REQUEST=auto
EXPECT_DEVICE_ARG=0
for arg in "$@"; do
  if [[ "$EXPECT_DEVICE_ARG" == 1 ]]; then DEVICE_REQUEST="$arg"; EXPECT_DEVICE_ARG=0
  elif [[ "$arg" == --device ]]; then EXPECT_DEVICE_ARG=1
  elif [[ "$arg" == --device=* ]]; then DEVICE_REQUEST="${arg#--device=}"
  fi
done
case "$DEVICE_REQUEST" in
  auto|cpu|cuda) ;;
  *) echo 'Device must be auto, cpu or cuda' >&2; exit 2 ;;
esac
GPU_PRESENT=0
if command -v nvidia-smi >/dev/null && nvidia-smi -L >/dev/null 2>&1; then GPU_PRESENT=1; fi
if [[ "$DEVICE_REQUEST" == cuda && "$GPU_PRESENT" == 0 ]]; then
  echo 'Forced GPU unavailable: NVIDIA GPU/driver not detected. Use --device cpu or auto.' >&2
  exit 1
fi
# CUDA wheels execute on both devices, allowing the dashboard to switch later.
if [[ "$GPU_PRESENT" == 1 ]]; then RUNTIME_FLAVOR=cuda; else RUNTIME_FLAVOR=cpu; fi
SETUP_REQUIRED=0
[[ -x "$RUNTIME_PY" ]] || SETUP_REQUIRED=1
[[ -f "$KEINFER_DEMO_HOME/runtime/.flavor" && "$(cat "$KEINFER_DEMO_HOME/runtime/.flavor")" == "$RUNTIME_FLAVOR" ]] || SETUP_REQUIRED=1
if [[ "$SETUP_REQUIRED" == 0 ]] && ! "$RUNTIME_PY" -c 'import torch, transformers, grpc, numpy, safetensors, huggingface_hub, tokenizers' >/dev/null 2>&1; then SETUP_REQUIRED=1; fi
if [[ "$SETUP_REQUIRED" == 1 ]]; then "$APP_ROOT/demo/runtime-setup.sh" "$RUNTIME_FLAVOR"; fi
if [[ ! -d "$KEINFER_BIN" ]]; then
  export KEINFER_BIN="$APP_ROOT/bin"
  export SHARDWISE_BIN="$KEINFER_BIN"
fi
if [[ ! -x "$KEINFER_BIN/controller" || ! -x "$KEINFER_BIN/nodeagent" ]]; then
  mkdir -p "$KEINFER_BIN"
  (cd "$APP_ROOT"; CGO_ENABLED=0 go build -o "$KEINFER_BIN/controller" ./cmd/controller; CGO_ENABLED=0 go build -o "$KEINFER_BIN/nodeagent" ./cmd/nodeagent)
fi
exec "$RUNTIME_PY" "$APP_ROOT/demo/app.py" "$@"
